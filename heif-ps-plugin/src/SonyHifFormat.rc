#include <windows.h>
#include "resource.h"

IDD_HIF_OPTIONS DIALOGEX 0, 0, 292, 146
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Sony HIF Import Options"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Image info", IDC_INFO_LABEL, 12, 10, 268, 12
    GROUPBOX        "Bit Depth & Color Pipeline", -1, 10, 26, 272, 72
    CONTROL         "32-bit Float Linear HDR (RGB/32)", IDC_RADIO_32F_HDR, "Button",
                    BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 18, 41, 256, 12
    CONTROL         "16-bit Integer Tone-Mapped (RGB/16)", IDC_RADIO_16U_TM, "Button",
                    BS_AUTORADIOBUTTON | WS_TABSTOP, 18, 59, 256, 12
    CONTROL         "16-bit Integer Raw Signal (RGB/16)", IDC_RADIO_16U_RAW, "Button",
                    BS_AUTORADIOBUTTON | WS_TABSTOP, 18, 77, 256, 12
    LTEXT           "Details", IDC_DESC_LABEL, 12, 102, 268, 18
    DEFPUSHBUTTON   "OK", IDOK, 174, 124, 52, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 230, 124, 52, 15
END

JSON_PIPL JSON "PiPLs.json"
